<Window x:Class="ValorantAutoLock.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ValorantAutoLock.Views"
        xmlns:vm="clr-namespace:ValorantAutoLock.ViewModels"
        xmlns:conv="clr-namespace:ValorantAutoLock.Converters"
        xmlns:models="clr-namespace:ValorantAutoLock.Models"
        mc:Ignorable="d"
        Title="Valorant Auto Lock" Height="600" Width="480"
        MinHeight="550" MinWidth="450"
        WindowStartupLocation="CenterScreen"
        Icon="../Resources/icon.ico"
        ResizeMode="CanResizeWithGrip">
    
    <Window.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:EnumToBoolConverter x:Key="EnumToBool"/>
        <conv:StringFormatConverter x:Key="StringFormat"/>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <Border Width="40" Height="40" CornerRadius="8" Background="{StaticResource PrimaryBrush}">
                <TextBlock Text="V" FontSize="20" FontWeight="Bold" Foreground="White" 
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding AppTitle, Source={x:Static local:Loc.Instance}}" Style="{StaticResource TitleText}"/>
                <TextBlock Text="Automatic Agent Locker" Style="{StaticResource MutedText}"/>
            </StackPanel>
        </StackPanel>

        <!-- Main Content -->
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay, FallbackValue=0}">
            <!-- Dashboard Tab -->
            <TabItem Header="{Binding TabDashboard, Source={x:Static local:Loc.Instance}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Status Card -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{Binding StatusTitle, Source={x:Static local:Loc.Instance}}" Style="{StaticResource SubtitleText}" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding Status}" Style="{StaticResource StatusText}" FontSize="16" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Current Match Info -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12" Visibility="{Binding CurrentMap, Converter={StaticResource NullToVis}}">
                            <StackPanel>
                                <TextBlock Text="{Binding CurrentMapTitle, Source={x:Static local:Loc.Instance}}" Style="{StaticResource SubtitleText}" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🗺️ " FontSize="16"/>
                                    <TextBlock Text="{Binding CurrentMap}" Style="{StaticResource BodyText}" FontSize="16" FontWeight="Medium"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12" Visibility="{Binding CurrentAgent, Converter={StaticResource NullToVis}}">
                            <StackPanel>
                                <TextBlock Text="{Binding LockedAgentTitle, Source={x:Static local:Loc.Instance}}" Style="{StaticResource SubtitleText}" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔒 " FontSize="16"/>
                                    <TextBlock Text="{Binding CurrentAgent}" Style="{StaticResource BodyText}" FontSize="16" FontWeight="Medium" Foreground="{StaticResource SuccessBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Stats -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal">
                                <StackPanel>
                                    <TextBlock Text="{Binding LocksThisSession}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                    <TextBlock Text="{Binding SessionLocksTitle, Source={x:Static local:Loc.Instance}}" Style="{StaticResource MutedText}"/>
                                </StackPanel>
                                <StackPanel Margin="24,0,0,0">
                                    <TextBlock Text="{Binding IsArmed, Converter={StaticResource BoolToVis}, ConverterParameter=Armed, FallbackValue=Disarmed}" 
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="{Binding IsArmed, Converter={StaticResource BoolToVis}, ConverterParameter={StaticResource SuccessBrush}, FallbackValue={StaticResource ErrorBrush}}"/>
                                    <TextBlock Text="{Binding ArmedStatusTitle, Source={x:Static local:Loc.Instance}}" Style="{StaticResource MutedText}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Action Buttons -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Content="{Binding BtnArm, Source={x:Static local:Loc.Instance}}" 
                                    Command="{Binding ArmCommand}" Style="{StaticResource PrimaryButton}"
                                    MinWidth="140" Height="44"/>
                            <Button Content="{Binding BtnDisarm, Source={x:Static local:Loc.Instance}}" 
                                    Command="{Binding DisarmCommand}" Style="{StaticResource SecondaryButton}"
                                    Margin="12,0,0,0" MinWidth="140" Height="44"/>
                        </StackPanel>

                        <!-- Error Display -->
                        <Border Style="{StaticResource CardStyle}" Background="#2A0A0A" BorderBrush="{StaticResource ErrorBrush}" 
                                Margin="0,0,0,12" Visibility="{Binding LastError, Converter={StaticResource NullToVis}}">
                            <StackPanel>
                                <TextBlock Text="⚠️ Error" Style="{StaticResource MutedText}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding LastError}" Style="{StaticResource BodyText}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Settings Tab -->
            <TabItem Header="{Binding TabSettings, Source={x:Static local:Loc.Instance}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- General Settings -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{Binding TabGeneral, Source={x:Static local:Loc.Instance}}" Style="{StaticResource SubtitleText}" Margin="0,0,16,12"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBlock Text="{Binding Language, Source={x:Static local:Loc.Instance}}" Style="{StaticResource BodyText}" VerticalAlignment="Center" Width="160"/>
                                    <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding CurrentLanguage, Mode=TwoWay}" Width="200"
                                              DisplayMemberPath=".">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={x:Static local:LanguageNameConverter.Instance}}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <CheckBox Content="{Binding StartMinimized, Source={x:Static local:Loc.Instance}}" IsChecked="{Binding StartMinimized}" Margin="0,4"/>
                                <CheckBox Content="{Binding MinimizeToTray, Source={x:Static local:Loc.Instance}}" IsChecked="{Binding MinimizeToTray}" Margin="0,4"/>
                            </StackPanel>
                        </Border>

                        <!-- Selection Mode -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{Binding SelectionMode, Source={x:Static local:Loc.Instance}}" Style="{StaticResource SubtitleText}" Margin="0,0,16,12"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <RadioButton Content="{Binding ModeGlobal, Source={x:Static local:Loc.Instance}}" 
                                                 IsChecked="{Binding SelectionMode, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static models:SelectionMode.Global}}"
                                                 GroupName="SelectionMode"/>
                                    <RadioButton Content="{Binding ModePerMap, Source={x:Static local:Loc.Instance}}" 
                                                 IsChecked="{Binding SelectionMode, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static models:SelectionMode.PerMap}}"
                                                 GroupName="SelectionMode" Margin="24,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Global Agent Settings -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12" Visibility="{Binding IsGlobalMode, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="{Binding GlobalAgent, Source={x:Static local:Loc.Instance}}" Style="{StaticResource SubtitleText}" Margin="0,0,16,12"/>
                                <ComboBox ItemsSource="{Binding Agents}" SelectedValue="{Binding GlobalAgentUuid, Mode=TwoWay}" 
                                          SelectedValuePath="Uuid" DisplayMemberPath="DisplayName" Width="300" HorizontalAlignment="Left"/>
                                <TextBlock Text="{Binding NoAgent, Source={x:Static local:Loc.Instance}}" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Per Map Settings -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12" Visibility="{Binding IsPerMapMode, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="{Binding AgentPerMap, Source={x:Static local:Loc.Instance}}" Style="{StaticResource SubtitleText}" Margin="0,0,16,12"/>
                                <ListView ItemsSource="{Binding MapAgents}" BorderThickness="0" Background="Transparent">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="140"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding MapName}" Style="{StaticResource BodyText}" VerticalAlignment="Center"/>
                                                <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableAgents}" 
                                                          SelectedValue="{Binding SelectedAgentUuid, Mode=TwoWay}" 
                                                          SelectedValuePath="Uuid" DisplayMemberPath="DisplayName"
                                                          VerticalAlignment="Center" Margin="12,0"/>
                                                <Button Grid.Column="2" Content="{Binding Clear, Source={x:Static local:Loc.Instance}}" 
                                                        Command="{Binding ClearCommand}" Style="{StaticResource GhostButton}"
                                                        Visibility="{Binding SelectedAgentUuid, Converter={StaticResource NullToVis}, ConverterParameter=True}"
                                                        Padding="8,4" FontSize="11"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>

                        <!-- Advanced Settings -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{Binding TabAdvanced, Source={x:Static local:Loc.Instance}}" Style="{StaticResource SubtitleText}" Margin="0,0,16,12"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBlock Text="{Binding MinDelay, Source={x:Static local:Loc.Instance}}" Style="{StaticResource BodyText}" VerticalAlignment="Center" Width="160"/>
                                    <Slider Minimum="0" Maximum="2000" Value="{Binding MinDelayMs}" Width="200" TickFrequency="100" IsSnapToTickEnabled="True"/>
                                    <TextBlock Text="{Binding MinDelayMs, StringFormat='{}{0} ms'}" Style="{StaticResource MutedText}" Width="60" VerticalAlignment="Center" TextAlignment="Right"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBlock Text="{Binding MaxDelay, Source={x:Static local:Loc.Instance}}" Style="{StaticResource BodyText}" VerticalAlignment="Center" Width="160"/>
                                    <Slider Minimum="0" Maximum="2000" Value="{Binding MaxDelayMs}" Width="200" TickFrequency="100" IsSnapToTickEnabled="True"/>
                                    <TextBlock Text="{Binding MaxDelayMs, StringFormat='{}{0} ms'}" Style="{StaticResource MutedText}" Width="60" VerticalAlignment="Center" TextAlignment="Right"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBlock Text="{Binding PollInterval, Source={x:Static local:Loc.Instance}}" Style="{StaticResource BodyText}" VerticalAlignment="Center" Width="160"/>
                                    <Slider Minimum="100" Maximum="2000" Value="{Binding PollIntervalMs}" Width="200" TickFrequency="100" IsSnapToTickEnabled="True"/>
                                    <TextBlock Text="{Binding PollIntervalMs, StringFormat='{}{0} ms'}" Style="{StaticResource MutedText}" Width="60" VerticalAlignment="Center" TextAlignment="Right"/>
                                </StackPanel>

                                <CheckBox Content="{Binding SelectBeforeLock, Source={x:Static local:Loc.Instance}}" IsChecked="{Binding SelectBeforeLock}" Margin="0,8"/>
                                <CheckBox Content="{Binding AutoReArm, Source={x:Static local:Loc.Instance}}" IsChecked="{Binding AutoReArm}" Margin="0,4"/>
                            </StackPanel>
                        </Border>

                        <!-- Save Button -->
                        <Button Content="{Binding Save, Source={x:Static local:Loc.Instance}}" 
                                Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Left" MinWidth="120" Height="40"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{Binding BtnSettings, Source={x:Static local:Loc.Instance}}" 
                    Command="{Binding OpenSettingsCommand}" Style="{StaticResource GhostButton}"/>
            <Button Content="{Binding TabDashboard, Source={x:Static local:Loc.Instance}}" 
                    Command="{Binding ShowDashboardCommand}" Style="{StaticResource GhostButton}" Margin="8,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>